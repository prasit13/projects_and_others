<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_gf283_top.wdb" id="1">
         <top_modules>
            <top_module name="glbl"/>
            <top_module name="tb_gf283_top"/>
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0fs"/>
      <ZoomEndTime time="1500000000fs"/>
      <Cursor1Time time="0fs"/>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="190"/>
      <ValueColumnWidth column_width="150"/>
   </column_width_setting>
   <WVObjectSize size="19"/>

   <wvobject fp_name="divider0" type="divider">
      <obj_property name="label">CLOCK / RESET</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/rst_n" type="logic">
      <obj_property name="ElementShortName">rst_n</obj_property>
      <obj_property name="ObjectShortName">rst_n</obj_property>
   </wvobject>

   <wvobject fp_name="divider1" type="divider">
      <obj_property name="label">COMMAND</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/start" type="logic">
      <obj_property name="ElementShortName">start</obj_property>
      <obj_property name="ObjectShortName">start</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/op" type="logic">
      <obj_property name="ElementShortName">op  (0=MUL 1=INV)</obj_property>
      <obj_property name="ObjectShortName">op</obj_property>
   </wvobject>

   <wvobject fp_name="divider2" type="divider">
      <obj_property name="label">OPERAND STREAM  (LSW first, 9 words)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/in_ready" type="logic">
      <obj_property name="ElementShortName">in_ready</obj_property>
      <obj_property name="ObjectShortName">in_ready</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/in_valid" type="logic">
      <obj_property name="ElementShortName">in_valid</obj_property>
      <obj_property name="ObjectShortName">in_valid</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/in_word" type="array">
      <obj_property name="ElementShortName">in_word[31:0]</obj_property>
      <obj_property name="ObjectShortName">in_word[31:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <wvobject fp_name="divider3" type="divider">
      <obj_property name="label">RESULT STREAM  (LSW first, 9 words)</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/out_valid" type="logic">
      <obj_property name="ElementShortName">out_valid</obj_property>
      <obj_property name="ObjectShortName">out_valid</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/out_ready" type="logic">
      <obj_property name="ElementShortName">out_ready</obj_property>
      <obj_property name="ObjectShortName">out_ready</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/out_word" type="array">
      <obj_property name="ElementShortName">out_word[31:0]</obj_property>
      <obj_property name="ObjectShortName">out_word[31:0]</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
   </wvobject>

   <wvobject fp_name="divider4" type="divider">
      <obj_property name="label">STATUS</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/busy" type="logic">
      <obj_property name="ElementShortName">busy</obj_property>
      <obj_property name="ObjectShortName">busy</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/done" type="logic">
      <obj_property name="ElementShortName">done</obj_property>
      <obj_property name="ObjectShortName">done</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/err_zero" type="logic">
      <obj_property name="ElementShortName">err_zero</obj_property>
      <obj_property name="ObjectShortName">err_zero</obj_property>
   </wvobject>

   <wvobject fp_name="divider5" type="divider">
      <obj_property name="label">SELF-CHECK COUNTERS</obj_property>
      <obj_property name="DisplayName">label</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/checks" type="array">
      <obj_property name="ElementShortName">checks</obj_property>
      <obj_property name="ObjectShortName">checks</obj_property>
      <obj_property name="Radix">UNSIGNEDRADIX</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_gf283_top/errors" type="array">
      <obj_property name="ElementShortName">errors</obj_property>
      <obj_property name="ObjectShortName">errors</obj_property>
      <obj_property name="Radix">UNSIGNEDRADIX</obj_property>
   </wvobject>
</wave_config>
